import java.util.Random;
import java.util.Scanner;

public class Angel extends Monster {
    Angel(int sizeBoard) {
        super(sizeBoard);
        this.setImage("\ud83d\udc7c");
    }

    public boolean taskMonster(int difficultGame) {
        System.out.println("Ангел задаёт вопрос:");
        Random random = new Random();
        int x = random.nextInt(10 * (difficultGame - 1), 10 * difficultGame);
        int y = random.nextInt(10 * (difficultGame - 1), 10 * difficultGame);
        int trueAnswer = x * y;
        System.out.println("Реши пример: " + x + " * " + y + " = ?");
        Scanner scanner = new Scanner(System.in);
        int answer = scanner.nextInt();
        if (trueAnswer == answer) {
            System.out.println("Верно! Ты получил 1 жизнь!");
            return true;
        } else {
            System.out.println("Ты неверно ответил!");
            return false;
        }
    }
}
